{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/geotrace/gps-route-recovery/schemas/trip.schema.json",
  "title": "GeoTraceLab trip",
  "description": "On-disk format written by the GeoTraceLab iOS app and consumed by the geotrace Python processor. A trip is a directory trip-<UUID>/ containing metadata.json, samples.jsonl, photos/ and results/.",
  "type": "object",
  "$defs": {
    "vector3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "description": "(w, x, y, z), device -> reference frame, as CMAttitude reports it.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "mountCalibration": {
      "type": "object",
      "properties": {
        "reference_quaternion": { "$ref": "#/$defs/quaternion" },
        "gravity_device": { "$ref": "#/$defs/vector3" },
        "forward_axis_device": {
          "description": "Vehicle forward axis in the device frame, from the straight-line calibration drive. Null if it was not performed.",
          "oneOf": [{ "$ref": "#/$defs/vector3" }, { "type": "null" }]
        },
        "initial_heading_deg": { "type": ["number", "null"] },
        "heading_source": { "enum": ["gps_course", "magnetometer", "unknown"] },
        "still_duration_s": { "type": "number", "minimum": 0 },
        "captured_at": { "type": ["string", "null"], "format": "date-time" }
      },
      "required": ["reference_quaternion", "gravity_device"]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "trip_id": { "type": "string", "description": "UUID of the trip." },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "ended_at": { "type": ["string", "null"], "format": "date-time" },
        "device_model": { "type": ["string", "null"] },
        "os_version": { "type": ["string", "null"] },
        "app_version": { "type": ["string", "null"] },
        "calibration": {
          "oneOf": [{ "$ref": "#/$defs/mountCalibration" }, { "type": "null" }]
        },
        "location_sample_count": { "type": "integer", "minimum": 0 },
        "motion_sample_count": { "type": "integer", "minimum": 0 },
        "notes": { "type": ["string", "null"] }
      },
      "required": ["trip_id"]
    },
    "locationSample": {
      "type": "object",
      "description": "One CoreLocation fix. A negative horizontal_accuracy marks an invalid fix and the processor discards it.",
      "properties": {
        "type": { "const": "location" },
        "wall_time": { "type": "string", "format": "date-time" },
        "monotonic_time": {
          "type": "number",
          "description": "Seconds on the device uptime clock. This is the timeline the filters use.",
          "minimum": 0
        },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude": { "type": "number" },
        "horizontal_accuracy": { "type": "number" },
        "vertical_accuracy": { "type": "number" },
        "speed": { "type": "number", "description": "m/s, negative when invalid." },
        "speed_accuracy": { "type": "number" },
        "course": { "type": "number", "description": "Degrees clockwise from true north, negative when invalid." },
        "course_accuracy": { "type": "number" },
        "source_information": {
          "type": "object",
          "description": "CLLocationSourceInformation, iOS 15+.",
          "properties": {
            "is_simulated_by_software": { "type": "boolean" },
            "is_produced_by_accessory": { "type": "boolean" }
          }
        },
        "synthetic": {
          "type": "boolean",
          "description": "Set by the fault injector on fixes it created or moved. Never set by the phone."
        }
      },
      "required": ["type", "monotonic_time", "latitude", "longitude"]
    },
    "motionSample": {
      "type": "object",
      "description": "One CMDeviceMotion frame, device frame, nominally 50 Hz.",
      "properties": {
        "type": { "const": "motion" },
        "monotonic_time": { "type": "number", "minimum": 0 },
        "wall_time": { "type": "string", "format": "date-time" },
        "user_acceleration_g": { "$ref": "#/$defs/vector3" },
        "user_acceleration_ms2": {
          "description": "Convenience copy: 9.80665 * user_acceleration_g.",
          "$ref": "#/$defs/vector3"
        },
        "rotation_rate": { "$ref": "#/$defs/vector3" },
        "gravity": { "$ref": "#/$defs/vector3" },
        "quaternion": { "$ref": "#/$defs/quaternion" },
        "attitude": {
          "description": "(roll, pitch, yaw) radians, diagnostics only.",
          "$ref": "#/$defs/vector3"
        },
        "magnetic_field": { "$ref": "#/$defs/vector3" },
        "magnetic_accuracy": {
          "type": "integer",
          "description": "CMMagneticFieldCalibrationAccuracy: -1 uncalibrated, 0 low, 1 medium, 2 high."
        }
      },
      "required": ["type", "monotonic_time", "user_acceleration_g", "rotation_rate", "gravity", "quaternion"]
    },
    "sample": {
      "description": "One line of samples.jsonl.",
      "oneOf": [
        { "$ref": "#/$defs/locationSample" },
        { "$ref": "#/$defs/motionSample" }
      ]
    },
    "ocrResult": {
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "bounding_box": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x, y, width, height] in Vision normalised image coordinates."
        }
      },
      "required": ["text", "confidence"]
    },
    "photo": {
      "type": "object",
      "description": "photos/photo-NNN.json, sidecar of photo-NNN.jpg.",
      "properties": {
        "image_path": { "type": "string" },
        "captured_at": { "type": ["string", "null"], "format": "date-time" },
        "monotonic_time": { "type": ["number", "null"] },
        "ocr": { "type": "array", "items": { "$ref": "#/$defs/ocrResult" } },
        "camera_orientation": { "type": ["string", "null"] },
        "device_heading_deg": { "type": ["number", "null"] },
        "assumed_latitude": {
          "type": ["number", "null"],
          "description": "Last position the app believed in. NOT a verified address."
        },
        "assumed_longitude": { "type": ["number", "null"] },
        "assumed_accuracy": { "type": ["number", "null"] },
        "exif_latitude": { "type": ["number", "null"] },
        "exif_longitude": { "type": ["number", "null"] },
        "note": { "type": ["string", "null"] }
      },
      "required": ["image_path", "ocr"]
    },
    "faults": {
      "type": "object",
      "description": "faults.json, written by `geotrace inject-fault`. Present only on a corrupted copy of a trip.",
      "properties": {
        "source_trip": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "seed": { "type": ["integer", "null"] },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["dropout", "offset", "drift", "jumps", "false_recovery"] },
              "start_s": { "type": "number", "description": "Seconds from trip start." },
              "duration_s": { "type": ["number", "null"] },
              "params": { "type": "object" },
              "affected_samples": { "type": "integer" }
            },
            "required": ["kind", "start_s"]
          }
        }
      },
      "required": ["faults"]
    }
  },
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "samples": { "type": "array", "items": { "$ref": "#/$defs/sample" } },
    "photos": { "type": "array", "items": { "$ref": "#/$defs/photo" } },
    "faults": { "$ref": "#/$defs/faults" }
  },
  "required": ["metadata", "samples"]
}
